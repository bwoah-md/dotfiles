<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu>

<menu id="client-menu">
  <item label="Minimize">
    <action name="Iconify" />
  </item>
  <item label="Maximize">
    <action name="ToggleMaximize" />
  </item>
  <item label="Fullscreen">
    <action name="ToggleFullscreen" />
  </item>
  <item label="Always on Top">
    <action name="ToggleAlwaysOnTop" />
  </item>
  <menu id="client-send-to-menu" />
  <separator />
  <item label="Close">
    <action name="Close" />
  </item>
</menu>

<menu id="root-menu">
  <item label="Open Terminal (foot)">
    <action name="Execute" command="foot" />
  </item>

  <item label="File Manager">
    <action name="Execute" command="pcmanfm-qt" />
  </item>

  <separator label="Noctalia" />

  <item label="Reload Configuration">
    <action name="Execute" command="noctalia msg config-reload" />
  </item>

  <item label="Wallpaper Selector">
    <action name="Execute" command="noctalia msg panel-toggle wallpaper" />
  </item>

  <item label="Settings">
    <action name="Execute" command="noctalia msg settings-toggle" />
  </item>

  <separator label="System" />

  <item label="Reload Environment">
    <action name="Reconfigure" />
  </item>

  <item label="Log Out">
    <action name="Exit" />
  </item>
</menu>

</openbox_menu>
