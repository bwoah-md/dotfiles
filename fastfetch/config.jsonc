{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "include": [
    "/home/icy/.config/fastfetch/themes/noctalia.jsonc"
  ],
  "logo": {
    "source": "/home/icy/.config/fastfetch/nixos-small.txt",
    "padding": {
      "top": 0,
      "right": 6
    },
    "color": {
      "1": "#a2b563",
      "2": "#dfb263"
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "#a2b574",
      "title": "#dfb26c"
    },
    "percent": {
      "color": {
        "green": "#e09260",
        "yellow": "#d0e996",
        "red": "#e37874"
      }
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "os",
      "key": "OS    ",
      "format": "NixOS"
    },
    {
      "type": "kernel",
      "key": "KER   ",
      "format": "{2}"
    },
    {
      "type": "packages",
      "key": "PKG   ",
      "format": "{nix-system}"
    },
    {
      "type": "shell",
      "key": "SH    ",
      "format": "{1}"
    },
    {
      "type": "terminal",
      "key": "TERM  ",
      "format": "{1}"
    },
    {
      "type": "command",
      "key": "WM    ",
      "text": "printf '%s' \"$XDG_CURRENT_DESKTOP\""
    },
    "break",
    {
      "type": "colors",
      "key": " ",
      "symbol": "square",
      "block": {
        "width": 4,
        "spacing": 4,
        "range": [
          0,
          4
        ]
      }
    }
  ]
}
