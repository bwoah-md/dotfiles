{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/icy/.config/fastfetch/microfetch.txt",
    "padding": {
      "top": 0,
      "left": 2,
      "right": 4
    },
    "color": {
      "1": "{{ colors.secondary.default.hex }}",
      "2": "{{ colors.primary.default.hex }}"
    }
  },
  "display": {
    "separator": "",
    "color": {
      "keys": "{{ colors.primary.default.hex }}",
      "title": "{{ colors.secondary.default.hex }}"
    },
    "percent": {
      "color": {
        "green": "{{ colors.primary.default.hex }}",
        "yellow": "{{ colors.primary.default.hex }}",
        "red": "{{ colors.primary.default.hex }}"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#1;38;2;{{ colors.secondary.default.red }};{{ colors.secondary.default.green }};{{ colors.secondary.default.blue }}}{user-name}{#38;2;{{ colors.error.default.red }};{{ colors.error.default.green }};{{ colors.error.default.blue }}}@{#1;38;2;{{ colors.primary.default.red }};{{ colors.primary.default.green }};{{ colors.primary.default.blue }}}{host-name}{#38;2;{{ colors.error.default.red }};{{ colors.error.default.green }};{{ colors.error.default.blue }}} ~{#0}"
    },
    "break",
    {
      "type": "os",
      "key": "os        ",
      "keyColor": "1;38;2;{{ colors.primary.default.red }};{{ colors.primary.default.green }};{{ colors.primary.default.blue }}",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "ker       ",
      "keyColor": "1;38;2;{{ colors.secondary.default.red }};{{ colors.secondary.default.green }};{{ colors.secondary.default.blue }}",
      "format": "{2}"
    },
    {
      "type": "shell",
      "key": "sh        ",
      "keyColor": "1;38;2;{{ colors.tertiary.default.red }};{{ colors.tertiary.default.green }};{{ colors.tertiary.default.blue }}",
      "format": "{1}"
    },
    {
      "type": "terminal",
      "key": "ter       ",
      "keyColor": "1;38;2;{{ colors.primary.default.red }};{{ colors.primary.default.green }};{{ colors.primary.default.blue }}",
      "format": "{1}"
    },
    {
      "type": "wm",
      "key": "comp      ",
      "keyColor": "1;38;2;{{ colors.secondary.default.red }};{{ colors.secondary.default.green }};{{ colors.secondary.default.blue }}",
      "format": "{2}"
    },
    {
      "type": "command",
      "key": "sess      ",
      "keyColor": "1;38;2;{{ colors.tertiary.default.red }};{{ colors.tertiary.default.green }};{{ colors.tertiary.default.blue }}",
      "text": "printf '%s' \"$XDG_SESSION_TYPE\" | tr '[:upper:]' '[:lower:]'"
    },
    {
      "type": "packages",
      "key": "pkgs      ",
      "keyColor": "1;38;2;{{ colors.primary.default.red }};{{ colors.primary.default.green }};{{ colors.primary.default.blue }}",
      "format": "{nix-system}"
    },
    "break",
    {
          "type": "command",
          "key": " ",
          "text": "printf '\\033[38;2;{{ colors.primary.default.red }};{{ colors.primary.default.green }};{{ colors.primary.default.blue }}m    \\033[38;2;{{ colors.secondary.default.red }};{{ colors.secondary.default.green }};{{ colors.secondary.default.blue }}m    \\033[38;2;{{ colors.tertiary.default.red }};{{ colors.tertiary.default.green }};{{ colors.tertiary.default.blue }}m    \\033[38;2;{{ colors.tertiary_fixed_dim.default.red }};{{ colors.tertiary_fixed_dim.default.green }};{{ colors.tertiary_fixed_dim.default.blue }}m    \\033[38;2;{{ colors.error.default.red }};{{ colors.error.default.green }};{{ colors.error.default.blue }}m\\033[0m'"
        },
        "break"
      ]
  }
