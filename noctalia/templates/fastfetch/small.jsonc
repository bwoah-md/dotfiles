
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/icy/.config/fastfetch/small.txt",
    "padding": {
      "top": 0,
      "right": 6
    },
    "color": {
      "1": "{{ colors.primary.default.hex }}",
      "2": "{{ colors.secondary.default.hex }}"
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "{{ colors.primary.default.hex }}",
      "title": "{{ colors.secondary.default.hex }}"
    },
    "percent": {
      "color": {
        "green": "{{ colors.tertiary.default.hex }}",
        "yellow": "{{ colors.tertiary_fixed_dim.default.hex }}",
        "red": "{{ colors.error.default.hex }}"
      }
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "os",
      "key": "OS    ",
      "format": "NixOS"
    },
    {
      "type": "kernel",
      "key": "KER   ",
      "format": "{2}"
    },
    {
      "type": "packages",
      "key": "PKG   ",
      "format": "{nix-system}"
    },
    {
      "type": "shell",
      "key": "SH    ",
      "format": "{1}"
    },
    {
      "type": "terminal",
      "key": "TERM  ",
      "format": "{1}"
    },
    {
      "type": "command",
      "key": "WM    ",
      "text": "printf '%s' \"$XDG_CURRENT_DESKTOP\""
    },
    "break",
    {
      "type": "command",
      "key": " ",
      "text": "printf '\\033[38;2;{{ colors.primary.default.red }};{{ colors.primary.default.green }};{{ colors.primary.default.blue }}m■ \\033[38;2;{{ colors.secondary.default.red }};{{ colors.secondary.default.green }};{{ colors.secondary.default.blue }}m■ \\033[38;2;{{ colors.tertiary.default.red }};{{ colors.tertiary.default.green }};{{ colors.tertiary.default.blue }}m■ \\033[38;2;{{ colors.tertiary_fixed_dim.default.red }};{{ colors.tertiary_fixed_dim.default.green }};{{ colors.tertiary_fixed_dim.default.blue }}m■ \\033[38;2;{{ colors.error.default.red }};{{ colors.error.default.green }};{{ colors.error.default.blue }}m■\\033[0m'"
    }
  ]
}
